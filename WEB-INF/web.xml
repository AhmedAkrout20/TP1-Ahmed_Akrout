<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>TP1</display-name>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <filter>
    <filter-name>LoggingFilter</filter-name>
    <filter-class>isep.lab1.filter.LoggingFilter</filter-class>
    <init-param>
      <param-name>logPrefix</param-name>
      <param-value>[LOGGING-FILTER]</param-value>
    </init-param>
  </filter>

  <filter>
    <filter-name>SecurityFilter</filter-name>
    <filter-class>isep.lab1.filter.SecurityFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>LoggingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>SecurityFilter</filter-name>
    <url-pattern>/ListItems</url-pattern>
  </filter-mapping>

  <listener>
    <listener-class>isep.lab1.listener.ApplicationAttributeListener</listener-class>
  </listener>

</web-app>
